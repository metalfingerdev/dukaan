# Copy to .env.local, or let `npx convex dev` create it on first run.
# Convex-side secrets (BETTER_AUTH_SECRET, RESEND_API_KEY, ...) are NOT set here:
# use `npx convex env set NAME value` (see docs/02-getting-started.md).
CONVEX_DEPLOYMENT=
PUBLIC_CONVEX_URL=
PUBLIC_CONVEX_SITE_URL=
# Optional: Google Maps browser key for the delivery pin. Public by design, so restrict it by HTTP
# referrer and to the Maps JavaScript and Geocoding APIs. Without it the map is simply hidden.
PUBLIC_GOOGLE_MAPS_API_KEY=
# Set to "staging" on the staging site only (shows a badge); leave empty elsewhere
PUBLIC_APP_ENV=
